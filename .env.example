# PostgreSQL (libpq reads PG* variables directly; docker-compose uses the same names)
PGHOST=localhost
PGPORT=5432
PGDATABASE=arxiv
PGUSER=postgres
PGPASSWORD=change-me

# Embedding
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Chunking (tokens are counted with the embedding model's own tokenizer)
CHUNK_TOKENS=200
CHUNK_OVERLAP=0.2

# Retrieval
HNSW_EF_SEARCH=100

# arXiv politeness (seconds between API pages / PDF downloads)
ARXIV_DELAY_SECONDS=3
PDF_DIR=data/pdfs
